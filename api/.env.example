# -- This is an example .env file for local development.
# -- Copy this file to .env and fill in the values. --
# -- Do not commit the .env file to version control. --

PORT=3001
FRONTEND_URL=http://localhost:5173
DATABASE_PATH=./data/database.sqlite # Example path

# --- SENSITIVE - DO NOT COMMIT REAL VALUES IN .env.example ---
# First admin account (3.0.0, D-063): read only while the database has no account at all,
# then ignored. Required on a database without account: the start is refused without them.
# Username: 3 to 32 letters, digits, ".", "_" or "-". Password: 6 characters minimum.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=change-me-locally
# -----------------------------------------------------------

# Number of reverse proxies in front of the API (Traefik: 1). 0 by default. Used for the client
# IP of the login attempts limiter (D-063).
TRUST_PROXY_HOPS=0
# The session cookie is Secure when NODE_ENV=production. false only for a local HTTP instance.
# COOKIE_SECURE=false

LOG_LEVEL=debug
NODE_ENV=development

# Instance currency: TOKEN (default) or EUR. Fixed once the database holds data (D-009).
CURRENCY=TOKEN
# Client (association) name shown in the header and the tab title (D-040). Optional.
CLIENT_NAME=
